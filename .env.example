# HuggingFace API Token for LLM features
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Optional: Custom model configurations
DEFAULT_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
BACKUP_LLM_MODEL=HuggingFaceH4/zephyr-7b-beta

# Optional: Analysis thresholds
HIGH_CONFIDENCE_THRESHOLD=80.0
MEDIUM_CONFIDENCE_THRESHOLD=60.0
HIGH_RISK_THRESHOLD=40
MEDIUM_RISK_THRESHOLD=70

# Optional: Text processing limits
MAX_TEXT_LENGTH=10000
MIN_TEXT_LENGTH=50

# Optional: Logging configuration
LOG_LEVEL=INFO
LOG_FILE=analysis_log.json
